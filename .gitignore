cat >> .gitignore << 'EOF'
# Dependências
node_modules/

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/

# Builds nativos
android/
ios/
*.apk
*.aab
*.ipa

# Variáveis de ambiente
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema e editor
.DS_Store
Thumbs.db
.vscode/
EOF
cd -